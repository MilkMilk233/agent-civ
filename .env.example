# Copy this file to .env and set your credentials.
# .env is read by docker compose for variable substitution.

# Provider can be: openai, google, anthropic
UNCIV_LLM_PROVIDER=openai

# Your gateway URL (or provider endpoint if not using gateway)
UNCIV_LLM_BASE_URL=https://ai-gateway.andrew.cmu.edu

# Shared fallback model recognized by your selected provider/gateway
UNCIV_LLM_MODEL=gpt-5-mini

# Separate models for the strategist and tactical planners
UNCIV_LLM_STRATEGIST_MODEL=gpt-5-mini
UNCIV_LLM_TACTICAL_MODEL=gpt-5-mini

# Required: API key/token
UNCIV_LLM_API_KEY=

# Optional: enable targeted AI-agent debug logging in Docker
JAVA_TOOL_OPTIONS=-DonlyLog=AgentTurnAutomation,AgentPlanProviderFactory,MultiProviderAgentPlanProvider,AgentActionExecutor

# Optional: embedded observability dashboard
UNCIV_AGENT_OBS_ENABLED=true
UNCIV_AGENT_OBS_PORT=7071
